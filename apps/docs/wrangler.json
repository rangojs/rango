{
  "name": "rango-docs",
  "routes": [
    {
      "pattern": "rangojs.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "main": "./src/worker.rsc.tsx",
  "assets": {
    "directory": "./dist/client"
  },
  "vars": {
    "SITE_URL": "https://rangojs.dev"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
