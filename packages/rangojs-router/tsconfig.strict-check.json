{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedDeclarations": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/server",
    "src/**/__fixtures__",
    "src/__augment-tests__",
    "src/**/__tests__",
    "src/**/__mocks__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
