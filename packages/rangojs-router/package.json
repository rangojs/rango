{
  "name": "@rangojs/router",
  "version": "0.4.2",
  "description": "Django-inspired RSC router with composable URL patterns",
  "keywords": [
    "react",
    "react-server-components",
    "router",
    "rsc",
    "vite"
  ],
  "homepage": "https://github.com/ivogt/vite-rsc#readme",
  "bugs": {
    "url": "https://github.com/ivogt/vite-rsc/issues"
  },
  "license": "MIT",
  "author": "Ivo Todorov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivogt/vite-rsc.git",
    "directory": "packages/rangojs-router"
  },
  "bin": {
    "rango": "./dist/bin/rango.js"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/__mocks__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist",
    "skills",
    "AGENTS.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.rsc.d.ts",
      "react-server": "./src/index.rsc.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "react-server": "./src/client.rsc.tsx",
      "default": "./src/client.tsx"
    },
    "./browser": {
      "types": "./dist/types/browser/index.d.ts",
      "default": "./src/browser/index.ts"
    },
    "./ssr": {
      "types": "./dist/types/ssr/index.d.ts",
      "default": "./src/ssr/index.tsx"
    },
    "./rsc": {
      "types": "./dist/types/rsc/index.d.ts",
      "react-server": "./src/rsc/index.ts",
      "default": "./src/rsc/index.ts"
    },
    "./vite": {
      "types": "./dist/types/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./types": {
      "types": "./src/vite/plugins/version.d.ts"
    },
    "./__internal": {
      "types": "./dist/types/__internal.d.ts",
      "default": "./src/__internal.ts"
    },
    "./internal/deps/browser": {
      "types": "./dist/types/deps/browser.d.ts",
      "default": "./src/deps/browser.ts"
    },
    "./internal/deps/ssr": {
      "types": "./dist/types/deps/ssr.d.ts",
      "default": "./src/deps/ssr.ts"
    },
    "./internal/deps/rsc": {
      "types": "./dist/types/deps/rsc.d.ts",
      "react-server": "./src/deps/rsc.ts",
      "default": "./src/deps/rsc.ts"
    },
    "./internal/deps/html-stream-client": {
      "types": "./dist/types/deps/html-stream-client.d.ts",
      "default": "./src/deps/html-stream-client.ts"
    },
    "./internal/deps/html-stream-server": {
      "types": "./dist/types/deps/html-stream-server.d.ts",
      "default": "./src/deps/html-stream-server.ts"
    },
    "./internal/rsc-handler": {
      "types": "./dist/types/rsc/handler.d.ts",
      "react-server": "./src/rsc/handler.ts",
      "default": "./src/rsc/handler.ts"
    },
    "./internal/browser/dev-discovery": {
      "types": "./dist/types/browser/dev-discovery.d.ts",
      "default": "./src/browser/dev-discovery.ts"
    },
    "./internal/browser/navigation-diagnostics": {
      "types": "./dist/types/browser/navigation-diagnostics.d.ts",
      "default": "./src/browser/navigation-diagnostics.ts"
    },
    "./internal/dev-diagnostics": {
      "types": "./dist/types/router/diagnostics/runtime-bridge.d.ts",
      "react-server": "./src/router/diagnostics/runtime-bridge.ts",
      "default": "./src/router/diagnostics/runtime-bridge.ts"
    },
    "./cache": {
      "types": "./dist/types/cache/index.d.ts",
      "react-server": "./src/cache/index.ts",
      "default": "./src/cache/index.ts"
    },
    "./cache-runtime": {
      "types": "./dist/types/cache/cache-runtime.d.ts",
      "react-server": "./src/cache/cache-runtime.ts",
      "default": "./src/cache/cache-runtime.ts"
    },
    "./cloudflare": {
      "types": "./dist/types/cloudflare/index.d.ts",
      "react-server": "./src/cloudflare/index.ts",
      "default": "./src/cloudflare/index.ts"
    },
    "./vercel": {
      "types": "./dist/types/vercel/index.d.ts",
      "react-server": "./src/vercel/index.ts",
      "default": "./src/vercel/index.ts"
    },
    "./theme": {
      "types": "./dist/types/theme/index.d.ts",
      "default": "./src/theme/index.ts"
    },
    "./build": {
      "types": "./dist/types/build/index.d.ts",
      "import": "./src/build/index.ts"
    },
    "./build/shell-capture": {
      "types": "./dist/types/prerender/build-shell-capture.d.ts",
      "react-server": "./src/prerender/build-shell-capture.ts",
      "import": "./src/prerender/build-shell-capture.ts"
    },
    "./host": {
      "types": "./dist/types/host/index.d.ts",
      "react-server": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./host/testing": {
      "types": "./dist/types/host/testing.d.ts",
      "default": "./src/host/testing.ts"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    },
    "./testing/vitest": {
      "types": "./dist/types/testing/vitest.d.ts",
      "default": "./dist/testing/vitest.js"
    },
    "./testing/dom": {
      "types": "./dist/types/testing/dom.entry.d.ts",
      "default": "./src/testing/dom.entry.ts"
    },
    "./testing/e2e": {
      "types": "./dist/types/testing/e2e/index.d.ts",
      "default": "./src/testing/e2e/index.ts"
    },
    "./testing/flight": {
      "types": "./dist/types/testing/flight.entry.d.ts",
      "react-server": "./src/testing/flight.entry.ts",
      "default": "./src/testing/flight.entry.ts"
    },
    "./testing/flight-matchers": {
      "types": "./dist/types/testing/flight-matchers.d.ts",
      "default": "./src/testing/flight-matchers.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm exec esbuild src/vite/index.ts --bundle --format=esm --outfile=dist/vite/index.js --platform=node --packages=external && mkdir -p dist/vite/plugins && cp src/vite/plugins/cloudflare-protocol-loader-hook.mjs dist/vite/plugins/cloudflare-protocol-loader-hook.mjs && pnpm exec esbuild src/testing/vitest.ts --bundle --format=esm --outfile=dist/testing/vitest.js --platform=node --packages=external && pnpm exec esbuild src/bin/rango.ts --bundle --format=esm --outfile=dist/bin/rango.js --platform=node --packages=external --banner:js='#!/usr/bin/env node' && chmod +x dist/bin/rango.js",
    "build:types": "rm -rf dist/types && pnpm exec tsc -p tsconfig.types.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.strict-check.json --noEmit && tsc -p tsconfig.augment-check.json --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:hmr-local": "playwright test --project=dev-warmup --project=hmr-basename --project=hmr-prerender --no-deps --workers=1 && RANGO_E2E_ROUTE_HMR_ONLY=1 playwright test --project=hmr-routes --no-deps --workers=1",
    "test:hmr-routes-local": "RANGO_E2E_ROUTE_HMR_ONLY=1 playwright test --project=hmr-routes --no-deps --workers=1",
    "test:unit": "pnpm run build:types && vitest run",
    "test:unit:watch": "vitest",
    "test:unit:rsc": "vitest run --config vitest.rsc.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/debug": "^4.1.12",
    "@vitejs/plugin-rsc": "^0.5.27",
    "debug": "^4.4.1",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^0.30.17",
    "picomatch": "^4.0.4",
    "rsc-html-stream": "^0.0.7",
    "srvx": "^0.11.15",
    "tinyexec": "^0.3.2",
    "typescript": "^5.3.0 || ^6.0.0",
    "undici": "^7.28.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@playwright/test": "^1.49.1",
    "@shared/e2e": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.1",
    "jiti": "^2.7.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": ">=16",
    "@vercel/functions": "^3.0.0",
    "@vitejs/plugin-rsc": "^0.5.27",
    "react": ">=19.2.6 <20",
    "react-dom": ">=19.2.6 <20",
    "vite": "^8.0.16",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vite-plugin": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@vercel/functions": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
