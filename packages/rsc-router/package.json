{
  "name": "rsc-router",
  "version": "0.1.0",
  "type": "module",
  "description": "Type-safe RSC router with partial rendering support",
  "author": "Ivo Todorov",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "react-server": "./src/client.rsc.tsx",
      "types": "./src/client.tsx",
      "default": "./src/client.tsx"
    },
    "./loader": {
      "react-server": "./src/loader.rsc.ts",
      "types": "./src/loader.ts",
      "default": "./src/loader.ts"
    },
    "./browser": {
      "types": "./src/browser/index.ts",
      "default": "./src/browser/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0"
  }
}
