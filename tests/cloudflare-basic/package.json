{
  "name": "cloudflare-basic",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:bindings": "pnpm build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:hmr-local": "playwright test --project=hmr --no-deps --workers=1",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:rsc": "vitest run --config vitest.rsc.config.ts"
  },
  "dependencies": {
    "@rangojs/router": "workspace:*",
    "@shared/docs": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "spin-delay": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "^1.49.1",
    "@rolldown/plugin-babel": "catalog:",
    "@shared/e2e": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "catalog:",
    "@types/node": "^24.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "happy-dom": "^20.10.1",
    "tinyexec": "^0.3.2",
    "typescript": "^5.7.0",
    "vite": "catalog:",
    "vitest": "^4.1.9",
    "wrangler": "^4.110.0"
  }
}
