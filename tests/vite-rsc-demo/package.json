{
  "name": "vite-rsc-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "playwright test --project=dev",
    "test:full": "playwright test",
    "test:production": "playwright test --project=production",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:rsc": "vitest run --config vitest.rsc.config.ts"
  },
  "dependencies": {
    "@rangojs/router": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@playwright/test": "^1.49.1",
    "@rolldown/plugin-babel": "catalog:",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "catalog:",
    "@types/node": "^24.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "happy-dom": "^20.10.1",
    "tinyexec": "^0.3.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.0"
  }
}
