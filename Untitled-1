            <p style="text-align: center; margin: 1rem 0;">
                {process.env.NODE_ENV === 'development' ? err.message : 'An error occurred'}
            </p>
            <div style="text-align: center; margin-top: 2rem;">
                <a href="/" style="color: #667eea;">Go Home</a>
            </div>
        </MinimalLayout>
    );
});

