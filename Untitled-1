// Layout middleware factory
const withLayout = (LayoutComponent) => {
    return async (c, next) => {
        c.set('Layout', LayoutComponent);
        await next();
    };
};

// Helper function to render with layout
const renderWithLayout = (c, children, layoutProps = {}) => {
    const Layout = c.get('Layout') || MainLayout;
    const user = c.get('user');
    const currentPath = c.req.path;

    return c.html(
        <Layout {...layoutProps} user={user} currentPath={currentPath}>
            {children}
        </Layout>
    );
};

// Auth middleware
const requireAuth = async (c, next) => {
    const user = c.get('user');
    if (!user) {
        return c.redirect('/auth/login');
    }
    await next();
};

