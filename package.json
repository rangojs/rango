{
  "name": "vite-rsc-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "rollup": "^4.54.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter rsc-router test:unit && pnpm --filter host-router test",
    "test:e2e": "pnpm --filter rsc-router test && pnpm --filter host-router test:e2e && pnpm --filter vite-rsc-demo test && pnpm --filter cloudflare-basic test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "turbo": "^2.6.0",
    "typescript": "^5.7.3"
  }
}
